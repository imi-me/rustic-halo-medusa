STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rustic_halo
DB_NAME=rustic_halo

# Local Stripe sandbox: only test keys are accepted when enabled.
STRIPE_TEST_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email. Keep disabled until an approved delivery test.
RESEND_API_KEY=
RESEND_FROM="Rustic Halo <orders@send.rustichalo.com>"
RESEND_REPLY_TO=contact@rustichalo.com
EMAIL_DELIVERY_ENABLED=false

# Set after publishing and checking the public HTTPS logo image.
EMAIL_LOGO_URL=

# Enable Redis-backed events, workflows, and distributed locks in deployed environments.
PERSISTENT_JOBS_ENABLED=false

# Etsy webhook intake remains disabled until the journal migration, signing
# secret, portal test delivery, deduplication, and rollback checks are approved.
ETSY_WEBHOOK_INGEST_ENABLED=false
ETSY_WEBHOOK_SIGNING_SECRET=
# Read-only admin report. Enabling this changes the next Etsy authorization
# request to include transactions_r; it never requests transactions_w.
ETSY_ORDER_REPORT_ENABLED=false

# Enable only after reset-email delivery and abuse protection are verified.
CUSTOMER_PASSWORD_RESET_ENABLED=false
# Full trusted storefront reset page URL, e.g. https://rustichalo.com/us/reset-password
CUSTOMER_PASSWORD_RESET_URL=

# Public product images only. Enable after bucket credentials and CDN are verified.
R2_STORAGE_ENABLED=false
R2_ENDPOINT=https://d58685cafb2507d6873952b5ee5b81b8.r2.cloudflarestorage.com
R2_BUCKET=rustic-halo-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
